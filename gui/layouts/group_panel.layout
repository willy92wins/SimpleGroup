       ignorepointer 1
       color 0 0 0 0
       position 0 0
       size 28 28
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       style rover_sim_colorable
      }

      ImageWidgetClass BtnCloseIcon {
       ignorepointer 1
       color 0.627 0.627 0.627 1
       position 7 7
       size 14 14
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       image0 "set:dayz_gui image:icon_x"
       mode blend
       "src alpha" 1
       stretch 1
       filter 1
      }
     }
     {
      ScriptParamsClass {
       Relay_Command "OnCloseExecute"
      }
     }
    }
   }
  }

