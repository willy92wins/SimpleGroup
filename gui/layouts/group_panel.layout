WrapSpacerWidgetClass LFPG_GroupPanel {
 color 0.1176 0.1176 0.1176 0.9804
 position 16 16
 size 400 300
 halign right_ref
 valign top_ref
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 style Colorable
 Padding 0
 Margin 0
 "Size To Content V" 1
 content_halign center
 {
  FrameWidgetClass HeaderFrame {
   position 0 0
   size 400 52
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    FrameWidgetClass GroupNameClip {
     ignorepointer 1
     clipchildren 1
     position 40 12
     size 320 32
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     {
      TextWidgetClass GroupNameText {
       scriptclass "ViewBinding"
       ignorepointer 1
