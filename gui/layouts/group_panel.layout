       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       font "gui/fonts/sdf_MetronBook24"
       "exact text" 1
       "exact text size" 24
       "text halign" center
       "text valign" center
       {
        ScriptParamsClass {
         Binding_Name "GroupName"
        }
       }
      }
     }
    }

    ButtonWidgetClass BtnClose {
     scriptclass "ViewBinding"
     position 360 12
