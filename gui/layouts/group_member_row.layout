   position 0 0
   size 308 34
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.11 0.118 0.129 1
   stretch 1
   ignorepointer 1
  }

  ImageWidgetClass OnlineIndicator {
   position 10 13
   size 8 8
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.373 0.373 0.373 1
   stretch 1
   ignorepointer 1
  }

  TextWidgetClass MemberNameText {
