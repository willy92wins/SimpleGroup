FrameWidgetClass LFPG_MemberRow {
 position 0 0
 size 288 38
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
  ImageWidgetClass RowBg {
   position 0 0
   size 288 34
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.11 0.118 0.129 1
   stretch 1
   ignorepointer 1
  }

  ImageWidgetClass OnlineIndicator {
   position 10 13
   size 8 8
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.373 0.373 0.373 1
   stretch 1
   ignorepointer 1
  }

  TextWidgetClass MemberNameText {
   scriptclass "ViewBinding"
   position 26 0
   size 172 34
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.878 0.878 0.878 1
   font "gui/fonts/MetronBook16"
   "text valign" center
   ignorepointer 1
   {
    ScriptParamsClass {
     Binding_Name "MemberName"
    }
   }
  }

  TextWidgetClass LeaderTagText {
   scriptclass "ViewBinding"
   position 200 0
   size 78 34
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.839 0.627 0.188 1
   font "gui/fonts/MetronBook12"
   "text halign" right
   "text valign" center
   ignorepointer 1
   {
    ScriptParamsClass {
     Binding_Name "LeaderTag"
    }
   }
  }

  ButtonWidgetClass BtnTransfer {
   scriptclass "ViewBinding"
   position 132 5
   size 80 24
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   visible 0
   style Colorable
   color 0.169 0.188 0.212 1
   {
    TextWidgetClass BtnTransferLabel {
     position 0 0
     size 80 24
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 0.847 0.847 0.847 1
     font "gui/fonts/MetronBook12"
     text "#STR_LFPG_UI_TRANSFER"
     "text halign" center
     "text valign" center
     ignorepointer 1
    }
   }
   {
    ScriptParamsClass {
     Relay_Command "OnTransferExecute"
    }
   }
  }

  ButtonWidgetClass BtnKick {
   scriptclass "ViewBinding"
   position 216 5
   size 66 24
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   visible 0
   style Colorable
   color 0.29 0.122 0.114 1
   {
